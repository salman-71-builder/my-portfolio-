# PostgreSQL connection string used by Prisma (cart & orders).
# Get a free serverless Postgres at https://neon.tech and paste the
# connection string here for local dev, and into Vercel's Environment
# Variables (Project → Settings → Environment Variables) for production.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Admin dashboard (/admin) ---
# Password for the admin login. ALWAYS set a strong value in production.
# Defaults to "admin123" if unset (dev only).
ADMIN_PASSWORD="change-me-to-a-strong-password"

# --- New-order email notifications (optional) ---
# Uses Resend (https://resend.com). Leave RESEND_API_KEY empty to disable
# emails — checkout still works, notifications are simply skipped.
RESEND_API_KEY=""
ADMIN_EMAIL="you@example.com"
EMAIL_FROM="Import China <onboarding@resend.dev>"

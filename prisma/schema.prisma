generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cart {
  id        String     @id @default(cuid())
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
}

model Order {
  id          String      @id @default(cuid())
  name        String
  email       String
  phone       String
  address     String
  city        String
  note        String?
  paymentMethod String    @default("Cash on Delivery")
  subtotal    Int
  shippingFee Int
  total       Int
  status      String      @default("pending")
  paid        Boolean     @default(false)
  items       OrderItem[]
  events      OrderEvent[]
  createdAt   DateTime    @default(now())

  @@index([email])
  @@index([createdAt])
}

/// Status-change + internal-note timeline for an order.
model OrderEvent {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    String? // set for status changes
  note      String? // set for internal notes
  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  productId String
  name      String
  image     String
  unitPrice Int
  quantity  Int
}

/// Manually-logged business expenses (operating costs) for the finance dashboard.
model Expense {
  id        String   @id @default(cuid())
  category  String // product_cost | shipping | customs | marketing | packaging | salaries | other
  amount    Int // BDT, whole taka
  note      String?
  date      DateTime // when the expense occurred
  createdAt DateTime @default(now())

  @@index([date])
}

/// Optional per-product cost-price override (COGS). When absent, cost is
/// estimated as a fixed ratio of the selling price (see lib/finance.ts).
model ProductCost {
  productId String   @id
  costPrice Int // BDT per unit
  updatedAt DateTime @updatedAt
}

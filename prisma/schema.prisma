generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cart {
  id        String     @id @default(cuid())
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
}

model Order {
  id          String      @id @default(cuid())
  name        String
  email       String
  phone       String
  address     String
  city        String
  note        String?
  paymentMethod String    @default("Cash on Delivery")
  subtotal    Int
  shippingFee Int
  total       Int
  status      String      @default("pending")
  paid        Boolean     @default(false)
  paymentPlan String? // full | 30_70 | 50_50 | installment_3 | cod | custom
  items       OrderItem[]
  events      OrderEvent[]
  payments    Payment[]
  installments Installment[]
  createdAt   DateTime    @default(now())

  @@index([email])
  @@index([createdAt])
}

/// A received payment toward an order (partial payments / installments).
model Payment {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  amount    Int // BDT
  method    String // bkash | nagad | rocket | bank | cod | cash | upay | surecash | other
  txnId     String?
  note      String?
  date      DateTime // when the payment was received
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([date])
}

/// Expected payment schedule (from a payment plan). Paid status is derived
/// from cumulative Payment totals at render time.
model Installment {
  id        String    @id @default(cuid())
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  label     String
  amount    Int
  dueDate   DateTime?
  sortOrder Int       @default(0)

  @@index([orderId])
}

/// Status-change + internal-note timeline for an order.
model OrderEvent {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    String? // set for status changes
  note      String? // set for internal notes
  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  productId String
  name      String
  image     String
  unitPrice Int
  quantity  Int
}

/// Manually-logged business expenses (operating costs) for the finance dashboard.
model Expense {
  id        String   @id @default(cuid())
  category  String // product_cost | shipping | customs | marketing | packaging | salaries | other
  amount    Int // BDT, whole taka
  note      String?
  date      DateTime // when the expense occurred
  createdAt DateTime @default(now())

  @@index([date])
}

/// Optional per-product cost-price override (COGS). When absent, cost is
/// estimated as a fixed ratio of the selling price (see lib/finance.ts).
model ProductCost {
  productId String   @id
  costPrice Int // BDT per unit
  updatedAt DateTime @updatedAt
}

/// Admin-editable shipping rate (per kg) keyed by method+class, e.g. "air_A",
/// "ship_B", "air_sunglasses". Defaults live in lib/shipping.ts.
model ShippingRate {
  key       String   @id
  perKg     Int
  updatedAt DateTime @updatedAt
}

/// Site logo + brand colours (single row, id="default"). Managed in /admin/branding.
/// Logo fields hold image data URLs (or hosted URLs).
model BrandingSettings {
  id           String   @id @default("default")
  mainLogo     String?
  iconLogo     String?
  footerLogo   String?
  loadingLogo  String?
  invoiceLogo  String?
  primaryColor String? // hex, e.g. #c0392b
  navyColor    String? // hex, e.g. #1a2f5e
  updatedAt    DateTime @updatedAt
}

/// Homepage hero banner, managed in /admin/banners.
model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  subtitle  String?
  ctaText   String?
  ctaHref   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}
